# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key - server-side only (seed scripts, admin bulk ops).
# NEVER expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) - generate once with:
#   node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k)"
# Not secret in the sense of auth bypass, but keep your own pair per environment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
